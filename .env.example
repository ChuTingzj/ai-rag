OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LEXICAL_BACKEND=tsv

# Python FastAPI / SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:15432/rag
# Nest Prisma (standard postgresql URL)
DATABASE_URL_NEST=postgresql://rag:rag@localhost:15432/rag

REDIS_URL=redis://localhost:16379
# openssl rand -hex 32
JWT_SECRET=
# shared secret between gateway and upstream services
INTERNAL_SERVICE_TOKEN=
# defaults to JWT_SECRET when unset
CONNECTOR_ENCRYPTION_SECRET=

FEISHU_APP_ID=
FEISHU_APP_SECRET=
DATA_DIR=./data

# Service ports (avoid a single PORT — each Nest app has its own)
GATEWAY_PORT=8080
AUTH_PORT=8081
CONNECTORS_PORT=8082
RAG_API_PORT=8000

# Upstream URLs (local dev)
AUTH_SERVICE_URL=http://127.0.0.1:8081
CONNECTORS_SERVICE_URL=http://127.0.0.1:8082
RAG_API_URL=http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8080

# Frontend (Next rewrite → gateway)
NEXT_PUBLIC_API_BASE_URL=/api/v1
