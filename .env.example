OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# local_bge_m3 needs: uv sync --all-groups --extra local-ml (Apple Silicon/Linux; Intel Mac: use openrouter)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIM=1024
RERANK_PROVIDER=stub
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LEXICAL_BACKEND=tsv

# Per-service databases (same Postgres host, different DB names)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:15432/rag
AUTH_DATABASE_URL=postgresql://rag:rag@localhost:15432/auth
CONNECTORS_DATABASE_URL=postgresql://rag:rag@localhost:15432/connectors

REDIS_URL=redis://localhost:16379
# openssl rand -hex 32
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
# defaults to JWT_SECRET when unset
CONNECTOR_ENCRYPTION_SECRET=

FEISHU_APP_ID=
FEISHU_APP_SECRET=
DATA_DIR=./data

GATEWAY_PORT=8080
AUTH_PORT=8081
CONNECTORS_PORT=8082
RAG_API_PORT=8000

AUTH_SERVICE_URL=http://127.0.0.1:8081
CONNECTORS_SERVICE_URL=http://127.0.0.1:8082
RAG_API_URL=http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8080

NEXT_PUBLIC_API_BASE_URL=/api/v1
