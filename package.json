{
  "name": "ai-rag",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "turbo run start:dev",
    "link-env": "./scripts/link-env.sh",
    "db:migrate": "turbo run db:migrate",
    "dev:gateway": "turbo run start:dev --filter=@ai-rag/gateway",
    "dev:auth": "turbo run start:dev --filter=@ai-rag/auth",
    "dev:connectors": "turbo run start:dev --filter=@ai-rag/connectors",
    "build:nest": "turbo run build --filter=@ai-rag/auth --filter=@ai-rag/connectors --filter=@ai-rag/gateway"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
