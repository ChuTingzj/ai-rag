generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("CONNECTORS_DATABASE_URL")
}

model Connector {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kbId            String? @map("kb_id") @db.Uuid
  type            String?
  configEncrypted Bytes?  @map("config_encrypted")
  cursor          String?
  enabled         Boolean?

  @@map("connectors")
}
